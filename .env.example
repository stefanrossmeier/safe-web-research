# Search provider
BRAVE_API_KEY=

# LLM provider
OPENROUTER_API_KEY=

# Runtime model override for CLI / Python examples.
# The code default is openai/gpt-5-mini if this remains empty.
# Example low-cost override: z-ai/glm-5.3-flash
OPENROUTER_MODEL=

# Model used by opt-in live integration tests.
# Current project test model:
OPENROUTER_TEST_MODEL=z-ai/glm-5.3-flash

# Other models exercised during portability testing include:
# OPENROUTER_TEST_MODEL=openai/gpt-5-mini
# OPENROUTER_TEST_MODEL=deepseek/deepseek-v4.1-flash

# Configuration only. Never commit real credentials.
