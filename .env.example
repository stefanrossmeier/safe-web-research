# Search provider
BRAVE_API_KEY=

# LLM provider
OPENROUTER_API_KEY=

# Runtime model override for CLI / Python examples.
# The code default is openai/gpt-5-mini if this remains empty.
# Example low-cost override: z-ai/glm-5.3-flash
OPENROUTER_MODEL=

# Semantic content-risk judgement is enabled by default in observe-only mode.
# Set to "off" to opt out. Observe mode emits events/usage but never filters evidence.
SAFE_WEB_RESEARCH_CONTENT_JUDGEMENT=observe

# Pin a concrete Jev version for reproducible behavior/evaluation.
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Model used by opt-in live integration tests.
# Current project test model:
OPENROUTER_TEST_MODEL=z-ai/glm-5.3-flash

# Other models exercised during portability testing include:
# OPENROUTER_TEST_MODEL=openai/gpt-5-mini
# OPENROUTER_TEST_MODEL=deepseek/deepseek-v4.1-flash

# Optional override for the live Jev Decisions smoke test.
OPENROUTER_JEV_TEST_MODEL=typesafe/jev-1.13

# Configuration only. Never commit real credentials.
